# 忽略虚拟环境及项目产生的临时文件
.venv/
venv/
venv_py310/
.idea/
.claude/
.qoder
.workbuddy
.vscode/
.trae/
.hermes
__pycache__/
.DS_Store
.pytest_cache
备注笔记.txt
# 忽略log文件，但保留.gitkeep和子目录
logs/*
!logs/.gitkeep
!logs/*/
logs/*/*
!logs/*/.gitkeep
# 忽略.env配置文件(但保留.env.example示例文件)
.env
# 环境文件的各种备份/派生名一律不入库（.env.bak 曾含明文凭据并被推送）
.env.bak
.env.*.bak
.env.local
.env.*.local
.sql
static_files/img/
# 备份文件统一忽略（此前只写了 `.bak`，它只匹配名为 .bak 的条目，不匹配 *.bak）
*.bak
# Redis/Memurai 落盘快照（运行时产物，可重建，不入库）
*.rdb
# 忽略所有 app/*/migrations/ 目录下的所有内容 (包括文件和子目录)
apps/*/migrations/*
# 使用否定模式，例外地跟踪 __init__.py 文件
!apps/*/migrations/__init__.py

# 忽略 allure-static 下的所有文件（运行时生成）
media/allure-static/*
!media/allure-static/.gitkeep

# 忽略 AI 录屏文件，但保留.gitkeep
media/ai_recording/*
!media/ai_recording/.gitkeep

# 忽略需求文档上传的文件，但保留.gitkeep
media/requirement_docs/*
!media/requirement_docs/.gitkeep

# 忽略缺陷附件上传的文件，但保留.gitkeep
media/defect_attachments/*
!media/defect_attachments/.gitkeep

# 忽略用例导入文件
media/testcase_imports
media/testcase_import_failures

# 忽略接口测试运行时产生的 Allure 报告文件，但保留.gitkeep文件
media/api-testing/allure-results/*
!media/api-testing/allure-results/.gitkeep
media/api-testing/allure-reports/*
!media/api-testing/allure-reports/.gitkeep
media/api-testing/allure-static/*
!media/api-testing/allure-static/.gitkeep

# 忽略 APP 自动化运行时产生的文件，但保留.gitkeep文件
media/app-automation/allure-results/*
!media/app-automation/allure-results/.gitkeep
media/app-automation/allure-reports/*
!media/app-automation/allure-reports/.gitkeep
media/app-automation/screenshots/*
!media/app-automation/screenshots/.gitkeep

# 忽略APP自动化模板文件
apps/app_automation/Template/**
!apps/app_automation/Template/

# 忽略性能测试模块生成文件
media/perf-testing
perf_workspace

# 忽略前端文件
frontend/node_modules/
frontend/.DS_Store
frontend/*.log
frontend/dist/

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# 工作区克隆的第三方被测目标（含他人代码/凭据），整目录排除，不混入自有仓库
work/

# 本机会话产生的临时日志/产物（非项目源码，勿入库）
%LOG%
_kill.txt
backend_run.log
scan_processes.csv
scan_processes_cleanup.txt
scan_processes_summary.txt
# testgen sidecar 部署配置（M3）需入库：放行以下例外（不影响 testhub 自身 Docker 规则）
!services/testgen/Dockerfile
!services/testgen/docker-compose.testgen.yml
!services/testgen/.dockerignore
# testgen sidecar 运行时数据（SQLite，可重建，不入库）
*.db
*.sqlite
*.sqlite3
nginx.conf
Makefile
build-multiplatform.sh
# 测试产物：E2E / UI 截图（二进制、体积大、可随时重跑生成）
services/testgen/scripts/ui_shots/
logs/e2e_ui/
