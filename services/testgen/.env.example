# ============================================================================
# testgen-service 环境变量模板
# 复制为 .env 后填入真实值；.env 已被 .gitignore 排除，**不要提交真实密钥**
# ============================================================================

# ---------- 运行 ----------
APP_ENV=dev
HOST=127.0.0.1
PORT=8100
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------- 存储（留空则用项目内 data/ outputs/ 默认值）----------
# DATA_DIR=
# OUTPUT_DIR=
# WORKSPACE_ROOT=
# DB_PATH=

# ---------- 只读工作区 ----------
# 分析完成后是否强制把代码目录置只读
READONLY_STRICT=on

# ---------- 审核门（on = 新产出待人工审核）----------
REVIEW_GATE=off

# ---------- LLM 增强通道（默认关闭：规则引擎必须能独立跑通）----------
LLM_ENHANCE=off
LLM_PROVIDER=qwen
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_API_KEY=
LLM_TIMEOUT=60

# ---------- API 鉴权（留空 = 不校验，仅限内网/开发）----------
AUTH_TOKEN=

# ---------- P1：业务函数提取收窄 ----------
# strict=排除测试/脚手架/构建脚本/配置模式类文件中的业务函数；loose=保留全部
BUSINESS_EXTRACT_MODE=strict
# strict 下仍视为独立能力的目录白名单（逗号分隔，相对仓库根）
# BUSINESS_INCLUDE_DIRS=tools,agents,mcp_servers,workspace/skills

# ---------- F5：功能点语义合并（默认开启）----------
# on = 同一语义的多条功能点收敛为一条（真实后端 vs mock server、静态页面 vs 运行时页面），
#      避免「功能点→测试点→用例」三级重复计数；off = 保留全部原始功能点（仅用于对照）。
# 口径见 engine/fp_merge.py（层类型对齐 + 路径归一 + 来源优先级）。
FP_SEMANTIC_MERGE=on

# ---------- P2：PRD 通道 + LLM 用例设计（默认关闭）----------
PRD_ENABLED=off
# PRD_DIR=                      # PRD 文档目录（留空=项目内 prd/）
LLM_DESIGN_ENABLED=off

# ---------- P3：运行时 UI 发现 / 用例执行（默认关闭）----------
# 总开关：开启后 pipeline 会用真实浏览器打开被测地址、登录并抓取 UI
RUNTIME_UI_ENABLED=off
# 被测环境地址（开启 RUNTIME_UI_ENABLED 后必填，否则启动即报错）
RUNTIME_BASE_URL=
# 登录页地址；留空则与 RUNTIME_BASE_URL 相同
# RUNTIME_LOGIN_URL=
# 表单登录凭证（**绝不提交、绝不入库**；未提供账号+密码时按匿名访问）
RUNTIME_LOGIN_USER=
RUNTIME_LOGIN_PASSWORD=
# 动态口令 / 一次性验证码（部分系统登录需要；不入库/不入日志）
# RUNTIME_LOGIN_OTP=
# 令牌型鉴权：值为环境变量「名」，其取值不入库/不入日志/不出现在 public_dict
# RUNTIME_AUTH_TOKEN_ENV=RUNTIME_AUTH_TOKEN
# RUNTIME_AUTH_TOKEN=
# 显式路由清单（逗号分隔，优先级最高）；留空则由「菜单点击发现 → 静态页面路径 → 首页链接」兜底
# RUNTIME_ROUTES=/pc/tasks,/pc/report
# 单页超时（秒）与单次遍历页面上限
RUNTIME_UI_TIMEOUT=30
RUNTIME_MAX_PAGES=60
# 无头模式；沙箱内无法下载 chromium 内核时可复用系统浏览器：msedge / chrome
PLAYWRIGHT_HEADLESS=on
PLAYWRIGHT_CHANNEL=
# P3：用例执行器（接口层真实执行；UI 层执行器待实现，会如实标记 skipped）
EXECUTOR_ENABLED=off
# 是否放行写操作（POST/PUT/PATCH/DELETE）。默认 off：写操作会真实变更被测环境数据，
# 只跑 GET/HEAD 等只读请求；确认环境可写后再开。
EXECUTOR_ALLOW_WRITE=off
