# ============================================================================
# testgen-service 环境变量模板
# 复制为 .env 后填入真实值；.env 已被 .gitignore 排除，**不要提交真实密钥**
# ============================================================================

# ---------- 运行 ----------
APP_ENV=dev
HOST=127.0.0.1
PORT=8100
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------- 存储（留空则用项目内 data/ outputs/ 默认值）----------
# DATA_DIR=
# OUTPUT_DIR=
# WORKSPACE_ROOT=
# DB_PATH=

# ---------- 只读工作区 ----------
# 分析完成后是否强制把代码目录置只读
READONLY_STRICT=on

# ---------- 审核门（on = 新产出待人工审核）----------
REVIEW_GATE=off

# ---------- LLM 增强通道（默认关闭：规则引擎必须能独立跑通）----------
LLM_ENHANCE=off
LLM_PROVIDER=qwen
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_API_KEY=
LLM_TIMEOUT=60

# ---------- API 鉴权（留空 = 不校验，仅限内网/开发）----------
AUTH_TOKEN=
# 未配 AUTH_TOKEN 且未显式设 AUTH_DISABLED=1 → 默认拒绝（fail-closed）
# AUTH_DISABLED=0

# ---------- CORS 来源白名单（逗号分隔；生产必配，未配则不允许跨域）----------
# dev/test 未配时保留通配供本机演示；生产务必显式列出前端来源
# CORS_ALLOWED_ORIGINS=http://localhost:3900,http://127.0.0.1:3900

# ---------- P1：业务函数提取收窄 ----------
# strict=排除测试/脚手架/构建脚本/配置模式类文件中的业务函数；loose=保留全部
BUSINESS_EXTRACT_MODE=strict
# strict 下仍视为独立能力的目录白名单（逗号分隔，相对仓库根）
# BUSINESS_INCLUDE_DIRS=tools,agents,mcp_servers,workspace/skills

# ---------- F5：功能点语义合并（默认开启）----------
# on = 同一语义的多条功能点收敛为一条（真实后端 vs mock server、静态页面 vs 运行时页面），
#      避免「功能点→测试点→用例」三级重复计数；off = 保留全部原始功能点（仅用于对照）。
# 口径见 engine/fp_merge.py（层类型对齐 + 路径归一 + 来源优先级）。
FP_SEMANTIC_MERGE=on

# ---------- T1：改动归属（默认开启）----------
# 私有函数（`_` 前缀）与被调用图吞并的辅助函数**不产功能点**，它们被改动时函数级收窄
# 会把整次改动丢掉（后端改了却一条用例都没有）。开启后按同文件反向调用图向上找最近的
# 路由 / lifespan 入口，把入口功能点补回保留集，证据写进运行备注。
# CHANGE_ATTRIBUTION=on
# 每次最多补几个入口（默认 1 个代表入口；其余入口的回归覆盖交给影响面通道）。
# CHANGE_ATTRIBUTION_MAX_ENTRIES=1

# ---------- T2：影响面回归（默认开启）----------
# 被改函数的调用入口（同文件反向调用图 ≤2 跳）不是「改动本体」，但改动可能让它们回归。
# 开启后补「因 X 改动，验证 Y 未回归」的用例，标签 受影响·直接 / 受影响·数据。
# 两条预算：单函数最多影响几个入口 / 整次最多几条；超出部分进报告 truncated，不静默丢弃。
# IMPACT_ENABLED=on
# IMPACT_MAX_PER_FUNC=3
# IMPACT_MAX_TOTAL=15

# ---------- T3：语义维度（灰度，默认仅项目 30 生效）----------
# 维度原本只由来源类型决定：改分页、改去重、改兜底，产出的用例都是「交互元素可用」。
# 开启后按 diff hunk 识别 8 类变更语义（分页/去重/列表新增/分支模式/契约形状/兜底/
# 零值守卫/鉴权），映射到具体维度（如「边界-分页游标同步」「正常-列表去重」）。
# 取值：off 全关 | on 全开 | project:30,31 仅列出的项目生效（关键词规则必有误匹配，
# 先单项目抽检；确认达标后再改 on）。兼容旧写法 TESTGEN_SEMANTIC_DIMS。
# SEMANTIC_DIMS=project:30
# 每个功能点的维度总上限（含 1 个核心类型维度；语义维度优先占位）。
# SEMANTIC_MAX_DIMS=4

# ---------- T4：前端跨文件（路由反查 + 文件级影响面）----------
# 路由反查：React/Vue 的路由常集中在 App.tsx，页面文件本身没有 path 声明，导致
# 「页面可达/未授权访问/极端视口」等地址类维度一条都展开不了。开启后从仓库静态路由表
# （<Route path="/x" element={<Page/>}> / {path:'/x',component:Page}）反查真实路由，
# 只采信绝对路由声明，且必须被组件名或文件名候选印证（不拿文件名硬猜）。
# 仅增量模式生效：全量模式放开会成倍放大全站页面维度，属行为大改。
# ROUTE_INFER=on
# 批次 B：只给「路由表 import 证据已绑定的屏幕」补 route_hint（用例地址），
# 不改 has_route、不新增维度——让文件级用例拿到真实 URL 而不是假文件名。
# 无直接绑定的组件可挂到 import 它的父页路由；两者都没有则如实保留文件级口径。
# ROUTE_FILE_HINT=on
# 文件级影响面：前端没有 AST 反向调用图，「父页面 import 了被改的子组件」在代码通道
# 不可见。开启后按 import 边补「引用区域未回归」用例（不断言具体元素）。
# FILE_IMPACT_ENABLED=on
# 每次最多补几条文件级用例（0 = 关闭该通道）；不设闸会刷出几十条「验证 X 页正常」空壳。
# FILE_IMPACT_MAX_TOTAL=2

# ---------- T5：生成后自检（命题门禁 + 三 KPI）----------
# 逐条校验三件事：有 evidence、expect 里有可观测对象、有来源标签（origin）。
# 不合规的测试点会被置 unverified 并写入 unverified_reason，且**不计入** KPI 分子
# —— KPI 虚高比 KPI 难看更危险（会让人以为改完了其实没测）。
# 门禁不删测试点：删掉会让人误以为「本来就没这个维度」。off 时只标 best_effort，
# 可用于与 T4 做对照（用例数一模一样的两次跑，看 KPI 差异）。
# QUALITY_GATE=on

# ---------- P2：PRD 通道 + LLM 用例设计（默认关闭）----------
PRD_ENABLED=off
# PRD_DIR=                      # PRD 文档目录（留空=项目内 prd/）
LLM_DESIGN_ENABLED=off

# ---------- P3：运行时 UI 发现 / 用例执行（默认关闭）----------
# 总开关：开启后 pipeline 会用真实浏览器打开被测地址、登录并抓取 UI
RUNTIME_UI_ENABLED=off
# 被测环境地址（开启 RUNTIME_UI_ENABLED 后必填，否则启动即报错）
RUNTIME_BASE_URL=
# 登录页地址；留空则与 RUNTIME_BASE_URL 相同
# RUNTIME_LOGIN_URL=
# 表单登录凭证（**绝不提交、绝不入库**；未提供账号+密码时按匿名访问）
RUNTIME_LOGIN_USER=
RUNTIME_LOGIN_PASSWORD=
# 动态口令 / 一次性验证码（部分系统登录需要；不入库/不入日志）
# RUNTIME_LOGIN_OTP=
# 令牌型鉴权：值为环境变量「名」，其取值不入库/不入日志/不出现在 public_dict
# RUNTIME_AUTH_TOKEN_ENV=RUNTIME_AUTH_TOKEN
# RUNTIME_AUTH_TOKEN=
# 显式路由清单（逗号分隔，优先级最高）；留空则由「菜单点击发现 → 静态页面路径 → 首页链接」兜底
# RUNTIME_ROUTES=/pc/tasks,/pc/report
# 批次 D（P3）：卡片式导航启发式三态（默认 auto，无需手动切换）：
#   off = 强制关闭；on = 强制开启；auto = 系统按发现结果自动判定——
#     仅当「显式 RUNTIME_ROUTES + 菜单发现 + 静态路由 + 首页链接」全空（只有地址、无代码）
#     才点卡片兜底；只要有任一确定性来源就自动关闭，避免点到「删除」类卡片产生副作用。
# 判定理由与误报审计写入发现 notes（前缀 [卡片导航 P3]），可追溯系统为何开/关。
# 任何开启态均带白名单容器/危险标签过滤/点击预算(12)/URL 变化确认四道护栏。
# RUNTIME_UI_CARD_NAV_MODE=auto
# 兼容旧布尔开关（已弃用；仅在新变量未设置时生效，true→on / false→off）：
# RUNTIME_UI_CARD_NAV_ENABLED=off
# 单页超时（秒）与单次遍历页面上限
RUNTIME_UI_TIMEOUT=30
RUNTIME_MAX_PAGES=60
# 无头模式；沙箱内无法下载 chromium 内核时可复用系统浏览器：msedge / chrome
PLAYWRIGHT_HEADLESS=on
PLAYWRIGHT_CHANNEL=
# P3：用例执行器（接口层真实执行；UI 层执行器待实现，会如实标记 skipped）
EXECUTOR_ENABLED=off
# 是否放行写操作（POST/PUT/PATCH/DELETE）。默认 off：写操作会真实变更被测环境数据，
# 只跑 GET/HEAD 等只读请求；确认环境可写后再开。
EXECUTOR_ALLOW_WRITE=off

# ---------- 专家审阅（PageExpert，逐页大模型调用）成本/时长护栏 ----------
# 背景：运行时 UI 通道下每个可达页面都要调一次大模型（实测 30~60s/页）。
# 39 页串行 = 半小时以上，面板只显示「专家逐页审阅」不动，看起来像卡死。
# 以下两个上限封顶；请求里 expert_ui=true 才会启用专家审阅（默认不启用）。
# 默认 3 页 / 90 秒（整体约 3~5 分钟收尾）。想多审几页再调大，别一次调回几十页。
# 注意：model_chain 里每个备选模型都会各自按 EXPERT_TIMEOUT（默认 60s）重试，
#       单页实测可达 170s —— 页内超时会被自动压到「剩余预算」内。
EXPERT_MAX_PAGES=3
EXPERT_TIME_BUDGET_SEC=90
