# ========== 虚拟环境 / 依赖 ==========
venv/
.venv/
env/
node_modules/

# ========== Python 缓存 ==========
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ========== 敏感配置（含明文密码、密钥、token）==========
.env
.env.*
!.env.example
*.env
*.pem
*.key
.secrets-allowlist.json

# ========== 运行时数据与产物（可重建）==========
*.db
*.sqlite
*.sqlite3
data/
outputs/
logs/

# ========== 被测目标代码：第三方仓库，非本项目代码 ==========
../targets/

# ========== 门禁/工具运行日志（会话级，不入库）==========
_*.log
