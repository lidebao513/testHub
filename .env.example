# ================================
# Docker镜像配置 - Docker Hub 示例
# 不用docker部署可以忽略
# ================================
# Docker Hub 配置 (留空或使用 docker.io)
DOCKER_REGISTRY=https://hub.docker.com/
DOCKER_NAMESPACE=your-namespace
IMAGE_VERSION=latest

# ================================
# 服务端口配置,不用docker部署可以忽略
# ================================
# 前端服务端口
FRONTEND_PORT=80
# 后端服务端口
BACKEND_PORT=8000
# 容器内部访问MySQL的端口（Docker网络内部通信）
DB_INTERNAL_PORT=3306

# ================================
# Django配置
# ================================
# Django密钥（生产环境请使用强密钥）
SECRET_KEY=your-secret-key-here-change-in-production
# 调试模式（生产环境请设为False）
DEBUG=True
# 允许的主机列表（生产环境请指定具体域名）
ALLOWED_HOSTS=*
# 允许的跨域来源（多个用逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# 是否通过 HTTPS 访问 Django（影响 CSRF/Session Secure Cookie 默认值）
APP_USE_HTTPS=False
# 当 Nginx/网关设置了 X-Forwarded-Proto 时，是否信任该请求头
TRUST_PROXY_SSL_HEADER=False
# Django 可信来源（Admin 登录、表单提交等需要；多个用逗号分隔）
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1,http://localhost
# 如需精细控制，可单独覆盖以下 Cookie 策略
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_HTTPONLY=True
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SAMESITE=Lax

# ================================
# 数据库配置
# ================================
# 数据库主机
DB_HOST=localhost
# 数据库名称
DB_NAME=testhub
# 数据库用户名
DB_USER=root
# 数据库密码
DB_PASSWORD=your-database-password
# MySQL数据库端口号
DB_PORT=3306

# ================================
# Redis 配置（Celery broker / Channels / 短信验证码共用）
# - 本地 Redis/Memurai 默认无密码：redis://127.0.0.1:6379/0
# - 生产必须显式配置（DEBUG=False 且未配置会 fail-fast），带密码示例：
#   redis://:你的密码@127.0.0.1:6379/0
# ================================
REDIS_URL=redis://127.0.0.1:6379/0

# ================================
# 阿里云短信配置
# ================================
SMS_ACCESS_KEY_ID=your-aliyun-access-key-id
SMS_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
SMS_SIGN_NAME=XXXXXX
SMS_REGISTER_TEMPLATE_CODE=XXXXXX

# ================================
# 邮件配置（可选,用于定时任务通知）
# ================================
EMAIL_HOST=smtp.163.com
EMAIL_PORT=465
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

# 日志配置
# LOG_LEVEL=INFO
# LOG_FILE=/app/logs/app.log

# ================================
# LLM 智能评分器配置（DeepSeek / OpenAI 兼容）
# ================================
# LLM API Key（必填，除非 JUDGE_MOCK=1；部署时优先用系统环境变量注入）
OPENAI_API_KEY=your-deepseek-api-key-here
# LLM Base URL（OpenAI 兼容接口，DeepSeek 默认如下）
OPENAI_BASE_URL=https://api.deepseek.com/v1
# 主裁判模型（deepseek-chat / deepseek-reasoner）
JUDGE_MODEL=deepseek-chat
# 离线联调开关：=1 时使用 MockJudge，不调用真实 LLM（零成本零延迟）
JUDGE_MOCK=1
# 评分运行次数（同一答案跑 n 次取中位数，降低随机性）
JUDGE_N_RUNS=3
# 多裁判模型列表（逗号分隔，启用多裁判投票取中位数）
# JUDGE_MODELS=deepseek-chat,deepseek-reasoner
# 评分缓存超时（秒，默认 1 小时）
JUDGE_CACHE_TIMEOUT=3600
# 规则引擎 LLM 降级开关：=1 时规则未命中项调用 LLM 兜底判断
JUDGE_RULE_LLM_FALLBACK=0

# 本地化配置
# 语言: 'en-us' (英语), 'zh-hans' (简体中文), 'ja' (日语), 'ko' (韩语) 等
# 时区: 参考 https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
LANGUAGE_CODE=zh-hans
TIME_ZONE=Asia/Shanghai

# ================================
# 生产环境注意事项
# ================================
# 1. 请务必修改SECRET_KEY为强密钥
# 2. 设置DEBUG=False
# 3. 在ALLOWED_HOSTS中指定具体域名，不要使用*
# 4. 在CORS_ALLOWED_ORIGINS中指定具体的前端域名
# 5. 使用环境变量管理敏感信息，不要提交到版本控制
# 6. 确保数据库密码足够强壮
# 7. 邮件配置使用真实的SMTP服务

# ---- LLM 成本护栏（apps/requirement_analysis/llm_budget）----------------------------
# 背景：阿里云百炼免费额度**耗尽后会自动转按量计费，不报错不中断**；旗舰模型
# 12~36 元/百万 token，AI 用例每步重发完整 DOM，一次十几万~百万 token。
LLM_BUDGET_ENFORCE=on
LLM_DAILY_TOKEN_BUDGET=300000
LLM_CALL_MAX_INPUT_TOKENS=24000
LLM_CALL_MAX_OUTPUT_TOKENS=4096
# 白名单：填「已确认开了用完即停」的模型名（逗号分隔）；留空则由付费关键字拦截
LLM_MODEL_ALLOWLIST=
LLM_ALLOW_PAID_MODEL=off

# ---- 模型登记册（LLM_MODEL_REGISTRY）------------------------------------------------
# 把「阿里云免费额度截图」里的模型逐条登记：每条 `模型名|类型|到期|是否开启`，多条逗号分隔。
# 类型：llm/text/chat/multimodal/omni = 可用于文本对话（多模态理解型可文本输出）；
#       image/vision/video = 视觉/视频生成（走原生接口）；
#       audio = 语音合成/识别（TTS/ASR，走语音专用接口）；realtime = 实时接口（WebSocket）；
#       embedding/rerank = 向量化/重排。
#       → 除 llm/text/chat/multimodal/omni 外，其余类型一律被护栏拒绝进文本链。
# 到期：YYYY-MM-DD / YYYY-MM-DD HH:MM[:SS] / YYYY/MM/DD（留空=长期，按「登记日 + N 天」自动失效）；
#       日期写错按 fail-closed 拒绝。到期当天仍可用（截图为「剩余 N 天」口径），次日才判过期。
#       截图写「每月1日额度重置·长期有效」的（如语音/合成模型）→ 用远期日期 2099-12-31 表达，
#       不要留空，否则会被「登记日 + 30 天」推定成即将过期。
# 同名重复：按「开启优先、先声明优先」去重并告警——换批次录入时旧的 off 条目不会顶掉新录入的 on 条目。
# 增强型校验：登记在册的模型会被额外判「类型/到期/开启」；不在册的模型仍走上方 allowlist/付费关键字。
# 下面是格式示例（真实清单按你自己的截图逐条录入，不要照抄）：
#   LLM_MODEL_REGISTRY=deepseek-v4-pro-0813|llm|2026-11-13|on,glm-5.3|llm|2026-11-23|on,qwen-image-3.0|image|2026-11-03|on,wan3.0-video|video|2026-11-05|on,sambert-zhide-v1|audio|2099-12-31|on
LLM_MODEL_REGISTRY=
# 到期留空（截图写「长期」）→ 不当作永久可用，按「登记日 + N 天（默认 30）」自动失效。
# LLM_MODEL_REGISTRY_SNAPSHOT = 这批模型的登记日（拿到截图并写配置的那天），换新截图时一并更新。
LLM_MODEL_REGISTRY_SNAPSHOT=2026-11-02
LLM_MODEL_DEFAULT_EXPIRY_DAYS=30
# 临近到期闸（分钟）：剩余时长 < 该值即**提前禁用**，避免调用跨过到期时刻产生按量费用。
LLM_EXPIRY_GUARD_MINUTES=60
# 免费额度耗尽标记文件（运行时 403 FreeTierOnly 自动写入）；留空 = data/llm_quota_state.json
LLM_QUOTA_STATE_PATH=

# ============================================================================
# UI 自动化 AI 模式（browser-use）
# ============================================================================
# 页面预探索（#177）：Agent 动手前先列一遍可交互元素，并把首屏清单写进执行日志。
# 关闭：UI_PRE_EXPLORE=0
UI_PRE_EXPLORE=1
# 模型分级路由（#178）：简单任务降到同厂轻档模型，复杂任务保持主模型。
# 判定复用 _step_complexity_score 口径（步骤数/动作数/连接词），长度分不计 URL。
# 关闭：UI_MODEL_ROUTING=0
UI_MODEL_ROUTING=1
# 轻档模型名。留空时按「重档→轻档」映射自动推断
# （deepseek-v4-pro→deepseek-v4.1-flash、qwen-max/plus→qwen-turbo、gpt-4o→gpt-4o-mini…）
UI_MODEL_LIGHT=
# 成本价目表（USD / 1M token）。不填则 cost 字段记 NULL（未知），不会写成 0 冒充免费。
# 格式：{"模型名": {"in": 输入单价, "out": 输出单价}}
# 示例：UI_MODEL_PRICE_JSON={"deepseek-v4.1-flash":{"in":0.07,"out":0.28}}
UI_MODEL_PRICE_JSON=

# ---- 动作 / 域名 / 内网守卫（M10 + #179，详见 docs/m10_prompt_injection_2026-10-30.md）----
# 高危动作黑名单：逗号分隔。"未设置"= 使用内置默认（evaluate/upload_file/read_file/write_file/replace_file
# 及 execute_js 等语义近亲）。
# ⚠️ 注意语义：写成 "UI_BLOCKED_ACTIONS="（值为空串）等于**不拦任何动作**，不是"回到默认"。
#    想用默认就别写这一行；这里故意注释掉，避免照抄 .env.example 把动作层关掉。
# UI_BLOCKED_ACTIONS=
# 域名白名单：逗号分隔，支持 example.com 与 .example.com 两种写法。
# 它同时是「内网私有段的显式放行名单」——平台自己的主用例跑在 127.0.0.1:8900、
# aiSitePilot 演示跑在局域网 :8099，要测内网地址必须写在这里（或写进任务描述里的 URL）。
UI_ALLOWED_DOMAINS=
# 域名越界策略：warn（默认，只记日志）/ strict（不在白名单一律拒绝）/ off（不校验域名）。
UI_DOMAIN_GUARD=warn
# 内网私有段策略（#179）：block（默认，10/8、172.16/12、192.168/16、0.0.0.0/8、fc00::/7 一律拦，
# 白名单里显式写了的除外）/ warn（只记日志）/ off（不校验）。
# 注意：云元数据端点（169.254.0.0/16、阿里云 100.100.100.200 及 metadata.* 域名）
# **无条件硬拦，没有开关**——它属于 SSRF 防护，不是可运维项。
UI_PRIVATE_NET_GUARD=block
